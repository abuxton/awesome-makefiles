# Terraform Enterprise / HCP Terraform API Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Required Configuration
# =============================================================================

# Your Terraform Enterprise or HCP Terraform API token
# Get it from: https://app.terraform.io/app/settings/tokens (HCP Terraform)
# Or: https://your-tfe-instance.com/app/settings/tokens (Terraform Enterprise)
TFE_TOKEN=your-token-here

# Your organization name
# Find it in the URL: https://app.terraform.io/app/YOUR-ORG-NAME/workspaces
TFE_ORG=your-organization-name

# =============================================================================
# Optional Configuration
# =============================================================================

# API endpoint (default: https://app.terraform.io for HCP Terraform)
# For Terraform Enterprise, use your instance URL:
# TFE_ADDR=https://terraform.example.com
TFE_ADDR=https://app.terraform.io

# =============================================================================
# Usage
# =============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Run: make check-deps
# 4. Run: make auth-check
# 5. Start using the API: make workspace-list

# =============================================================================
# Security Notes
# =============================================================================

# - NEVER commit .env to git (already in .gitignore)
# - Keep your TFE_TOKEN secret and secure
# - Use team tokens for CI/CD, user tokens for local development
# - Rotate tokens regularly
# - See: https://developer.hashicorp.com/terraform/cloud-docs/users-teams-organizations/api-tokens
